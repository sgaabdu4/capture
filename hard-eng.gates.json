{
  "version": 1,
  "packages": [
    {
      "name": ".",
      "path": ".",
      "language": "dart",
      "sources": ["lib"],
      "checks": [
        {
          "name": "security",
          "role": "security",
          "parallel": true,
          "command": [
            "semgrep",
            "scan",
            "--config",
            ".agents/skills/he/security",
            "--jobs",
            "2",
            "--error",
            "--strict",
            "--time",
            "--json",
            "--output",
            "coverage/semgrep.json",
            "."
          ],
          "report": {
            "type": "semgrep",
            "path": "coverage/semgrep.json"
          }
        },
        {
          "name": "vulnerabilities",
          "role": "vulnerabilities",
          "parallel": true,
          "command": [
            "osv-scanner",
            "scan",
            "source",
            "--lockfile=pubspec.lock",
            "--all-packages",
            "--format=json",
            "--output-file=coverage/osv.json"
          ],
          "report": {
            "type": "osv",
            "path": "coverage/osv.json"
          }
        },
        {
          "name": "lockfile",
          "role": "lockfiles",
          "command": ["flutter", "pub", "get", "--enforce-lockfile"]
        },
        {
          "name": "format",
          "role": "format",
          "parallel": true,
          "command": [
            "sh",
            "-c",
            "set -e; candidates=$(mktemp); files=$(mktemp); trap 'rm -f \"$candidates\" \"$files\"' EXIT HUP INT TERM; git ls-files -z --cached --others --exclude-standard -- '*.dart' ':(glob,exclude)**/build/**' ':(glob,exclude)**/.dart_tool/**' ':(exclude).agents/**' ':(exclude).hooks/**' ':(exclude)vendor/**' > \"$candidates\"; xargs -0 sh -c 'for path in \"$@\"; do if [ -f \"$path\" ]; then printf \"%s\\0\" \"$path\"; fi; done' sh < \"$candidates\" > \"$files\"; [ -s \"$files\" ] || exit 0; xargs -0 dart format --output=none --set-exit-if-changed < \"$files\""
          ]
        },
        {
          "name": "types-lint",
          "role": "types",
          "parallel": true,
          "command": ["dart", "analyze", "--fatal-infos", "."]
        },
        {
          "name": "tests",
          "role": "tests",
          "command": [
            "flutter",
            "test",
            "--no-pub",
            "--machine",
            "--coverage",
            "--coverage-path=coverage/lcov.info"
          ],
          "report": {
            "type": "dart-tests",
            "tests": "coverage/tests.jsonl",
            "coverage": "coverage/lcov.info"
          }
        },
        {
          "name": "dead-code-duplicates",
          "role": "dead-code-duplicates",
          "command": [
            "dart-decimate",
            "check",
            ".",
            "--threshold",
            "0",
            "--strict",
            "--format",
            "json"
          ],
          "report": {
            "type": "dart-decimate",
            "path": "coverage/dart-decimate.json",
            "stdout": true
          }
        },
        {
          "name": "performance",
          "role": "performance",
          "command": [
            "flutter",
            "test",
            "--no-pub",
            "--machine",
            "test/performance"
          ],
          "report": {
            "type": "performance-dart",
            "path": "coverage/performance.jsonl",
            "stdout": true
          }
        }
      ],
      "depends_on": []
    },
    {
      "name": "ios",
      "path": "ios",
      "language": "swift",
      "sources": ["CaptureControls", "Runner"],
      "checks": [
        {
          "name": "format-lint",
          "role": "format-lint",
          "parallel": true,
          "command": [
            "swift",
            "format",
            "lint",
            "--strict",
            "--recursive",
            "--parallel",
            "CaptureControls",
            "Runner",
            "RunnerTests"
          ]
        },
        {
          "name": "tests",
          "role": "tests",
          "command": [
            "sh",
            "-c",
            "set -e; mkdir -p coverage; rm -rf coverage/tests.xcresult; platform=$(basename \"$PWD\"); flutter precache --\"$platform\"; if [ \"$platform\" = macos ]; then files() { git ls-files -z --cached --others --exclude-standard -- . | xargs -0 cat | cksum; }; before=$(files); (cd .. && flutter build macos --config-only --no-pub); [ \"$(files)\" = \"$before\" ] || { echo 'Flutter changed files in macos while preparing the project; review and commit them' >&2; exit 1; }; destination=platform=macOS; else devices=$(xcrun simctl list devices available | grep -E '^ +iPhone' || true); id='[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}'; udid=$(printf '%s\\n' \"$devices\" | grep -F '(Booted)' | grep -Eo \"$id\" | tail -n 1 || true); [ -n \"$udid\" ] || udid=$(printf '%s\\n' \"$devices\" | grep -Eo \"$id\" | tail -n 1 || true); [ -n \"$udid\" ] || { echo 'No iPhone simulator is available' >&2; exit 1; }; destination=id=$udid; fi; xcodebuild test -quiet -workspace Runner.xcworkspace -scheme Runner -configuration Debug -destination \"$destination\" -enableCodeCoverage YES -onlyUsePackageVersionsFromResolvedFile -resultBundlePath coverage/tests.xcresult 'SWIFT_TREAT_WARNINGS_AS_ERRORS=$(HARD_ENG_STRICT_$(PROJECT_NAME))' HARD_ENG_STRICT_Runner=YES; xcrun xcresulttool get test-results summary --path coverage/tests.xcresult > coverage/swift-tests.json; xcrun xccov view --report --json coverage/tests.xcresult > coverage/swift-coverage.json"
          ],
          "report": {
            "type": "xcode-tests",
            "tests": "coverage/swift-tests.json",
            "coverage": "coverage/swift-coverage.json"
          }
        },
        {
          "name": "duplicates",
          "role": "duplicates",
          "command": [
            "jscpd",
            "CaptureControls",
            "Runner",
            "--format",
            "swift",
            "--threshold",
            "0",
            "--max-size",
            "100mb",
            "--max-lines",
            "1000000",
            "--reporters",
            "json",
            "--output",
            "coverage/jscpd"
          ],
          "report": {
            "type": "jscpd",
            "path": "coverage/jscpd/jscpd-report.json"
          }
        },
        {
          "name": "security",
          "role": "security",
          "parallel": true,
          "command": [
            "semgrep",
            "scan",
            "--config",
            "../.agents/skills/he/security",
            "--jobs",
            "2",
            "--error",
            "--strict",
            "--time",
            "--json",
            "--output",
            "coverage/semgrep.json",
            "CaptureControls",
            "Runner",
            "RunnerTests"
          ],
          "report": {
            "type": "semgrep",
            "path": "coverage/semgrep.json"
          }
        }
      ],
      "depends_on": [],
      "impact_inputs": ["pubspec.yaml", "pubspec.lock"]
    },
    {
      "name": "macos",
      "path": "macos",
      "language": "swift",
      "sources": ["Runner"],
      "checks": [
        {
          "name": "format-lint",
          "role": "format-lint",
          "parallel": true,
          "command": [
            "swift",
            "format",
            "lint",
            "--strict",
            "--recursive",
            "--parallel",
            "Runner",
            "RunnerTests"
          ]
        },
        {
          "name": "tests",
          "role": "tests",
          "command": [
            "sh",
            "-c",
            "set -e; mkdir -p coverage; rm -rf coverage/tests.xcresult; platform=$(basename \"$PWD\"); flutter precache --\"$platform\"; if [ \"$platform\" = macos ]; then files() { git ls-files -z --cached --others --exclude-standard -- . | xargs -0 cat | cksum; }; before=$(files); (cd .. && flutter build macos --config-only --no-pub); [ \"$(files)\" = \"$before\" ] || { echo 'Flutter changed files in macos while preparing the project; review and commit them' >&2; exit 1; }; destination=platform=macOS; else devices=$(xcrun simctl list devices available | grep -E '^ +iPhone' || true); id='[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}'; udid=$(printf '%s\\n' \"$devices\" | grep -F '(Booted)' | grep -Eo \"$id\" | tail -n 1 || true); [ -n \"$udid\" ] || udid=$(printf '%s\\n' \"$devices\" | grep -Eo \"$id\" | tail -n 1 || true); [ -n \"$udid\" ] || { echo 'No iPhone simulator is available' >&2; exit 1; }; destination=id=$udid; fi; xcodebuild test -quiet -workspace Runner.xcworkspace -scheme Runner -configuration Debug -destination \"$destination\" -enableCodeCoverage YES -onlyUsePackageVersionsFromResolvedFile -resultBundlePath coverage/tests.xcresult 'SWIFT_TREAT_WARNINGS_AS_ERRORS=$(HARD_ENG_STRICT_$(PROJECT_NAME))' HARD_ENG_STRICT_Runner=YES; xcrun xcresulttool get test-results summary --path coverage/tests.xcresult > coverage/swift-tests.json; xcrun xccov view --report --json coverage/tests.xcresult > coverage/swift-coverage.json"
          ],
          "report": {
            "type": "xcode-tests",
            "tests": "coverage/swift-tests.json",
            "coverage": "coverage/swift-coverage.json"
          }
        },
        {
          "name": "duplicates",
          "role": "duplicates",
          "command": [
            "jscpd",
            "Runner",
            "--format",
            "swift",
            "--threshold",
            "0",
            "--max-size",
            "100mb",
            "--max-lines",
            "1000000",
            "--reporters",
            "json",
            "--output",
            "coverage/jscpd"
          ],
          "report": {
            "type": "jscpd",
            "path": "coverage/jscpd/jscpd-report.json"
          }
        },
        {
          "name": "security",
          "role": "security",
          "parallel": true,
          "command": [
            "semgrep",
            "scan",
            "--config",
            "../.agents/skills/he/security",
            "--jobs",
            "2",
            "--error",
            "--strict",
            "--time",
            "--json",
            "--output",
            "coverage/semgrep.json",
            "Runner",
            "RunnerTests"
          ],
          "report": {
            "type": "semgrep",
            "path": "coverage/semgrep.json"
          }
        }
      ],
      "depends_on": [],
      "impact_inputs": ["pubspec.yaml", "pubspec.lock"]
    }
  ],
  "shared": [
    {
      "name": "secrets-files",
      "role": "secrets-files",
      "parallel": true,
      "command": [
        "gitleaks",
        "dir",
        ".",
        "--redact=100",
        "--no-banner",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-files.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-files.sarif"
      }
    },
    {
      "name": "secrets-history",
      "role": "secrets-history",
      "parallel": true,
      "command": [
        "gitleaks",
        "git",
        ".",
        "--redact=100",
        "--no-banner",
        "--log-opts=--all",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-history.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-history.sarif"
      }
    },
    {
      "name": "actionlint",
      "role": "workflows",
      "parallel": true,
      "command": ["actionlint", "-no-color"]
    },
    {
      "name": "zizmor",
      "role": "ci-security",
      "parallel": true,
      "command": [
        "zizmor",
        "--strict-collection",
        "--persona=auditor",
        "--format=plain",
        "."
      ]
    }
  ],
  "shipping": {
    "base": "main",
    "checks": ["hard-eng"],
    "ui_paths": [
      "lib/features/*/presentation/*",
      "lib/core/theme/*",
      "lib/core/widgets/*",
      "macos/Runner/*",
      "assets/*"
    ],
    "ci_seconds": 420,
    "pre_push_seconds": 240,
    "delivery": []
  }
}
